{
  "manifest_version": 3,
  "name": "omarchy-continuity",
  "version": "0.1.0",
  "description": "Open or move the current tab to the machine next to you over the Thunderbolt link.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "tabs",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Move this tab to the other machine",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "open-on-other": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Open this tab on the other machine"
    },
    "move-to-other": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Move this tab to the other machine"
    }
  }
}
