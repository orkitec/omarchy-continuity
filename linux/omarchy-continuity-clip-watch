#!/bin/bash
# omarchy-continuity-clip-watch — send this machine's clipboard to the Mac as it changes.
#
# Deskflow's Wayland clipboard path only notices a change when the set of MIME types
# changes, passes the payload as a command-line argument (anything over 128 KB is lost)
# and mangles images, and upstream has dropped it. This replaces it: wl-paste --watch
# reports every copy through the compositor's data-control protocol, and the content is
# piped to the Mac's `clip` verb over the restricted continuity key, stdin all the way.
#
#   omarchy-continuity-clip-watch            run the watchers (user service)
#   omarchy-continuity-clip-watch --send M   callback: stdin is the new clipboard of type M
#
# Echo protection: `clip` on either side records the SHA-256 of what it received, the
# sender records what it last sent, and a change matching either hash is not sent.
set -u
export PATH="/usr/local/bin:/usr/bin:$PATH"
STATE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-continuity"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-continuity/peer"
MAX="${OC_CLIP_MAX_BYTES:-8388608}"
mkdir -p "$STATE"
log() { logger -t omarchy-continuity "$*"; }

peer() {
  host=""; user=""; key="$HOME/.ssh/omarchy-continuity"
  [[ -f $CONF ]] || return 1
  while IFS='=' read -r k v; do
    case "$k" in host) host="$v" ;; user) user="$v" ;; key) key="$v" ;; esac
  done < "$CONF"
  # The Mac account at the console, as last reported by its heartbeat, wins over the peer file.
  local seen="${CONF%/*}/mac-user"
  if [[ -s $seen ]]; then read -r active < "$seen"; [[ -n $active ]] && user="$active"; fi
  [[ -n $host && -n $user && -f $key ]]
}

send() {
  local mime="$1" tmp size sha
  tmp=$(mktemp "$STATE/clip-out.XXXXXX")
  head -c "$((MAX + 1))" > "$tmp"
  size=$(stat -c %s "$tmp")
  if (( size == 0 )); then rm -f "$tmp"; return 0; fi
  if (( size > MAX )); then
    log "clipboard not sent: $size bytes exceeds ${MAX} (OC_CLIP_MAX_BYTES)"
    rm -f "$tmp"; return 0
  fi
  sha=$(sha256sum < "$tmp" | cut -d' ' -f1)
  if [[ $sha == "$(cat "$STATE/clip-in.sha" 2>/dev/null)" || $sha == "$(cat "$STATE/clip-out.sha" 2>/dev/null)" ]]; then
    rm -f "$tmp"; return 0   # came from the Mac, or already there
  fi
  if ! peer; then rm -f "$tmp"; return 0; fi
  if ssh -i "$key" -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=3 \
       -o StrictHostKeyChecking=accept-new "$user@$host" "clip $mime" < "$tmp" >/dev/null 2>"$tmp.err"; then
    printf '%s\n' "$sha" > "$STATE/clip-out.sha"
    [[ -f $STATE/clip-fail ]] && { rm -f "$STATE/clip-fail"; log "clipboard to Mac working again"; }
  elif [[ ! -f $STATE/clip-fail ]]; then
    # One line per outage, not one per copy: the cable is out or the Mac is asleep.
    touch "$STATE/clip-fail"
    log "clipboard to Mac failed ($mime, $size bytes): $(tr '\n' ' ' < "$tmp.err" | cut -c1-160)"
  fi
  rm -f "$tmp" "$tmp.err"
}

if [[ ${1:-} == "--send" ]]; then
  send "${2:?mime type}"
  exit 0
fi

# Two watchers, like Omarchy's own clipboard history: text and PNG. wl-paste only runs
# the callback when the clipboard offers that type, and -n keeps the bytes exact so the
# hashes match what the Mac sent.
command -v wl-paste >/dev/null || { echo "wl-paste not found" >&2; exit 1; }
wl-paste -n --type text --watch "$0" --send text/plain &
wl-paste -n --type image/png --watch "$0" --send image/png &
wait -n
exit 1   # one watcher died; let systemd restart both
