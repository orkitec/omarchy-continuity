#!/bin/bash
# omarchy-continuityd — SSH forced command on the Omarchy machine.
#
# The Mac connects over the Thunderbolt link with a key that is restricted (in
# ~/.ssh/authorized_keys) to this command, so the only things it can ever do here
# are the verbs below. SSH_ORIGINAL_COMMAND carries "<verb> [argument]".
#
#   lock            lock the screen (and stop holding it awake)
#   unlock          unlock the screen (needs the face-unlock plugin's opt-in IPC unlock)
#   awake           heartbeat: the Mac is connected and unlocked, keep this machine from
#                   idle-locking; expires on its own if the heartbeats stop (cable out).
#                   If the screen is locked because the Mac locked it, this unlocks it:
#                   after a fast user switch over there the arriving account has no
#                   unlock event of its own, only heartbeats.
#   status          lock screen status as JSON
#   open <url>      open an http(s) URL in the default browser
#   clip [mime]     stdin becomes this machine's clipboard (text/plain or image/png);
#                   the Mac's watcher sends every copy made over there
set -u

export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export PATH="$OMARCHY_PATH/bin:/usr/local/bin:/usr/bin:$PATH"
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  sig=$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)
  [[ -n $sig ]] && export HYPRLAND_INSTANCE_SIGNATURE="$sig"
fi

STATE="$XDG_RUNTIME_DIR/omarchy-continuity"
mkdir -p "$STATE"

cmd="${SSH_ORIGINAL_COMMAND:-$*}"
verb="${cmd%% *}"
arg=""
[[ $cmd == *" "* ]] && arg="${cmd#* }"
peer="${SSH_CLIENT:-}"; peer="${peer%% *}"
log() { logger -t omarchy-continuity "$*"; }

# Idle inhibit is Omarchy's own "stay awake" toggle. We only ever release it if
# we were the ones who set it, so a stay-awake the user chose is left alone.
# The toggle is one shared flag, so if something else switches it off while we
# hold it (the menu, `omarchy toggle idle`), the next heartbeat takes it again:
# the Mac being unlocked is the rule, and the hold is only as good as the flag.
hold_awake() {
  touch "$STATE/awake"
  local enabled=0
  [[ $(omarchy-toggle-idle status 2>/dev/null) == *'"enabled":true'* ]] && enabled=1
  if [[ -f $STATE/inhibiting ]]; then
    (( enabled )) && return
    omarchy-toggle-idle stay-awake >/dev/null 2>&1 && log "re-holding awake (stay-awake was switched off while the Mac is unlocked)"
    return
  fi
  (( enabled )) && return  # user already holds it; don't take ownership
  omarchy-toggle-idle stay-awake >/dev/null 2>&1 && touch "$STATE/inhibiting" && log "holding awake (Mac unlocked)"
}
release_awake() {
  rm -f "$STATE/awake"
  if [[ -f $STATE/inhibiting ]]; then
    omarchy-toggle-idle allow-idle >/dev/null 2>&1
    rm -f "$STATE/inhibiting"
    log "released awake hold"
  fi
}

case "$verb" in
  lock)
    release_awake
    if [[ $(omarchy-shell lock isLocked 2>/dev/null) == "true" ]]; then
      echo "already-locked"
    else
      omarchy-system-lock >/dev/null 2>&1
      # Remember that the Mac did this, so a heartbeat may undo it. A lock you did
      # yourself here stays locked while the Mac's heartbeats keep coming.
      touch "$STATE/locked-by-mac"
      log "lock requested by ${peer:-local}"
      echo "ok"
    fi
    ;;
  unlock)
    out=$(omarchy-shell lock unlock 2>&1)
    rm -f "$STATE/locked-by-mac"
    log "unlock requested by ${peer:-local}: ${out:-no-reply}"
    hold_awake
    echo "${out:-failed}"
    ;;
  awake)
    # Optional arguments: the Mac account at the console (remembered so tab hand-off and
    # lock requests from here go to that account, the Mac has several) and the Mac's
    # Wi-Fi address, kept for omarchy-continuity-wake-mac since a sleeping Mac cannot
    # be asked for it.
    if [[ -n $arg ]]; then
      account="${arg%% *}"; wifi=""
      [[ $arg == *" "* ]] && wifi="${arg#* }"
      if [[ $account =~ ^[a-z_][a-z0-9._-]{0,31}$ ]]; then
        # Kept under ~/.config, not the runtime dir, so it survives a reboot here: the
        # clipboard watcher needs an account before the first heartbeat arrives.
        conf="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-continuity"
        if [[ $(cat "$conf/mac-user" 2>/dev/null) != "$account" ]]; then
          mkdir -p "$conf"
          printf '%s\n' "$account" > "$conf/mac-user.tmp" && mv "$conf/mac-user.tmp" "$conf/mac-user"
          log "Mac console user is now $account"
        fi
      else
        echo "rejected" >&2
        exit 65
      fi
      if [[ $wifi =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]]; then
        conf="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-continuity"
        if ! grep -qsx "mac=$wifi" "$conf/mac-wifi"; then
          mkdir -p "$conf"
          { grep -vs '^mac=' "$conf/mac-wifi"; echo "mac=$wifi"; } > "$conf/mac-wifi.tmp" && mv "$conf/mac-wifi.tmp" "$conf/mac-wifi"
          log "Mac Wi-Fi address is now $wifi"
        fi
      fi
    fi
    if [[ -f $STATE/locked-by-mac ]]; then
      if [[ $(omarchy-shell lock isLocked 2>/dev/null) == "true" ]]; then
        out=$(omarchy-shell lock unlock 2>&1)
        log "unlocked on heartbeat (Mac locked this screen, is unlocked now): ${out:-no-reply}"
      fi
      rm -f "$STATE/locked-by-mac"
    fi
    hold_awake
    echo "ok"
    ;;
  status)
    omarchy-shell lock status
    ;;
  open)
    # Only web URLs, no whitespace, bounded length: this is the one verb that takes input.
    shopt -s extglob
    if [[ ${#arg} -gt 4096 || $arg != http?(s)://+([!\ ]) ]]; then
      echo "rejected" >&2
      exit 65
    fi
    # Run inside the user's systemd session so the browser gets the graphical environment.
    if systemd-run --user --quiet --collect --unit="omarchy-continuity-open-$$" xdg-open "$arg" 2>/dev/null; then
      log "open requested by ${peer:-local}: ${arg:0:120}"
      echo "ok"
    else
      echo "failed"
      exit 1
    fi
    ;;
  clip)
    # The Mac's pasteboard watcher pipes each copy here. Only two formats travel, the
    # payload is bounded, and the content hash is remembered so the clipboard watcher on
    # this side does not send the same bytes straight back (see omarchy-continuity-clip-watch).
    mime="${arg:-text/plain}"
    case "$mime" in
      text/plain | text/plain\;charset=utf-8) mime="text/plain;charset=utf-8" ;;
      image/png) ;;
      *) echo "rejected" >&2; exit 65 ;;
    esac
    max="${OC_CLIP_MAX_BYTES:-8388608}"
    tmp=$(mktemp "$STATE/clip.XXXXXX")
    head -c "$((max + 1))" > "$tmp"
    size=$(stat -c %s "$tmp")
    if (( size == 0 )) || (( size > max )); then
      rm -f "$tmp"
      echo "rejected" >&2
      exit 65
    fi
    sha256sum < "$tmp" | cut -d' ' -f1 > "$STATE/clip-in.sha"
    # sshd gives the forced command no Wayland environment; find the session's socket.
    if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
      for sock in "$XDG_RUNTIME_DIR"/wayland-*; do
        [[ -S $sock ]] && export WAYLAND_DISPLAY="${sock##*/}" && break
      done
    fi
    # wl-copy forks a child that serves the clipboard for as long as it is current; keep it
    # out of this SSH session so the disconnect does not take it (and the clipboard) down.
    if setsid -w wl-copy --type "$mime" < "$tmp" >/dev/null 2>&1; then
      echo "ok"
    else
      log "clipboard from Mac: wl-copy failed ($mime, $size bytes)"
      echo "failed"
      rm -f "$tmp"
      exit 1
    fi
    rm -f "$tmp"
    ;;
  *)
    echo "omarchy-continuity: unknown command '${verb}'" >&2
    exit 64
    ;;
esac
