#!/bin/bash
# omarchy-continuityd — SSH forced command on the Mac (Remote Login must be on).
#
# The Omarchy machine connects with a key restricted to this command, so these
# verbs are all it can do here. SSH_ORIGINAL_COMMAND carries "<verb> [argument]".
#
#   lock            put the display to sleep, which locks if "require password" is on
#   open <url>      open an http(s) URL in the default browser
#   status          "locked" / "unlocked"
#   clip [mime]     stdin becomes this Mac's pasteboard (text/plain or image/png);
#                   the Omarchy machine's clipboard watcher sends every copy made there
set -u
shopt -s extglob
STATE="$HOME/Library/Application Support/omarchy-continuity/state"

cmd="${SSH_ORIGINAL_COMMAND:-$*}"
verb="${cmd%% *}"
arg=""
[[ $cmd == *" "* ]] && arg="${cmd#* }"

case "$verb" in
  lock)
    /usr/bin/pmset displaysleepnow
    echo "ok"
    ;;
  status)
    if /usr/sbin/ioreg -n Root -d1 -a 2>/dev/null | grep -q 'CGSSessionScreenIsLocked'; then echo "locked"; else echo "unlocked"; fi
    ;;
  open)
    if [[ ${#arg} -gt 4096 || $arg != http?(s)://+([!\ ]) ]]; then
      echo "rejected" >&2
      exit 65
    fi
    /usr/bin/open "$arg" && echo "ok"
    ;;
  clip)
    # Bounded payload, two formats. The hash of what arrived is kept so the lock watcher's
    # pasteboard poll recognises it and does not send the same bytes straight back.
    mime="${arg:-text/plain}"
    case "$mime" in
      text/plain | text/plain\;charset=utf-8) mime="text/plain" ;;
      image/png) ;;
      *) echo "rejected" >&2; exit 65 ;;
    esac
    max="${OC_CLIP_MAX_BYTES:-8388608}"
    tmp=$(mktemp -t omarchy-continuity-clip)
    head -c "$((max + 1))" > "$tmp"
    size=$(stat -f %z "$tmp")
    if (( size == 0 )) || (( size > max )); then
      rm -f "$tmp"
      echo "rejected" >&2
      exit 65
    fi
    mkdir -p "$STATE"
    /usr/bin/shasum -a 256 < "$tmp" | cut -d' ' -f1 > "$STATE/clip-in.sha"
    if [[ $mime == text/plain ]]; then
      /usr/bin/pbcopy < "$tmp" && echo "ok"
    else
      /usr/bin/osascript -e "set the clipboard to (read (POSIX file \"$tmp\") as «class PNGf»)" >/dev/null && echo "ok"
    fi
    rm -f "$tmp"
    ;;
  *)
    echo "omarchy-continuity: unknown command '${verb}'" >&2
    exit 64
    ;;
esac
